# C4 与按键/LED 同属 3.3V Bank 42，必须使用统一的 LVCMOS33。
set_pin_assignment	{ I_sys_clk }	{ LOCATION = C4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# KEY1 低有效复位。D5 来自同一开发板已验证的板级约束；A9 留给 KEY2/I_button[0]。
set_pin_assignment	{ I_rst_n   }	{ LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

#camera
set_pin_assignment	{ O_cam_scl }	{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }	{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }	{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

#key
set_pin_assignment	{ I_button[0] }	{ LOCATION = A9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[1] }	{ LOCATION = B9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[2] }	{ LOCATION = C7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_gear_sw }	{ LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_ae_sw   }	{ LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

#SCREEN PWM
set_pin_assignment	{ O_screen_pwm }	{ LOCATION = T5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }

#HDMI TX
set_pin_assignment	{ O_tmds_ch0_p }	{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }	{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }	{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }	{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }

# 检测结果外部控制：象限 LED + 蜂鸣器（扩展要求 2.4(3)）
set_pin_assignment	{ O_led[0] }	{ LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_led[1] }	{ LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_led[2] }	{ LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_led[3] }	{ LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_buzzer }	{ LOCATION = C12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# 云台追踪使能拨码开关 SW2（B4）：拨上(1)=开启 M5 云台追踪，拨下(0)=关闭追踪仅识别
set_pin_assignment	{ I_gim_en }	{ LOCATION = B4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# 三轴云台 —— MCU 路线（RISC-V 硬核）
set_pin_assignment	{ O_mcu_pwm_yaw   }	{ LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_mcu_pwm_pitch }	{ LOCATION = L15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_mcu_pwm_roll  }	{ LOCATION = L16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }

# MCU UART0 → 板载 USB-UART（CH340）
set_pin_assignment	{ O_mcu_uart0_tx  }	{ LOCATION = H1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ I_mcu_uart0_rx  }	{ LOCATION = J1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# MCU I2C0 → 扩展排针 J11：Pin37=J13(SCL), Pin38=K13(SDA)
set_pin_assignment	{ IO_mcu_i2c_scl  }	{ LOCATION = J13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_mcu_i2c_sda  }	{ LOCATION = K13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
